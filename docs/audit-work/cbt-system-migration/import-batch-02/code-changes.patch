+        : `독립 검수 ${record.review.verdict} · 런타임 통합 대기`;
+    case "published":
+      return `독립 검수 ${record.review.verdict} · 공개 승인`;
+    case "choice_conflict":
+      return "선택지 충돌 · 비채점 등록";
