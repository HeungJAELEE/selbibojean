# Public Supabase project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ENABLE_GOOGLE_OAUTH=false
ENABLE_KAKAO_OAUTH=false
ENABLE_ACCOUNT_PURGE=false

# Server-only values. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
USERNAME_EMAIL_DOMAIN=accounts.invalid
RATE_LIMIT_HMAC_SECRET=
CRON_SECRET=
ADMIN_ALLOWLIST_EMAILS=

# Supabase Edge Function purge gates. Keep every destructive gate false until
# disposable-account boundary, race, provider unlink, and auth readback tests pass.
ACCOUNT_PURGE_ENABLED=false
ACCOUNT_PURGE_AUTH_DELETE_ENABLED=false
ACCOUNT_PURGE_KAKAO_UNLINK_ENABLED=false
PURGE_AUDIT_HMAC_SECRET=
KAKAO_ADMIN_KEY=
ENABLE_MOCK_CHOICE_SHUFFLE=false
ENABLE_BUSAN_KOPO_MEDIA=false

# Required only when generating public/robots.txt and public/sitemap.xml for a static deployment.
# Use the final HTTPS origin, for example https://your-project.pages.dev (no trailing path).
SITE_URL=

# Public AdSense publisher ID used by the verification meta tag and loader script.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-5167419072810145

# Optional: absolute path used only when running the local workbook importer.
SOURCE_WORKBOOK_PATH=
WELDING_SAFETY_WORKBOOK_PATH=
WELDING_SAFETY_REPORT_PATH=
